# --- Abgeleiteter Output (wird neu erzeugt, gehoert nicht in die Historie) ---
# graphify schreibt graph.json (1,8 MB) und graph.html (1,5 MB) bei jedem Update
# komplett neu -- im Git wuerde das die Historie dauerhaft aufblaehen.
graphify-out/
# Verirrter Semantic-Cache mitten im Content-Verzeichnis (144 JSON-Dateien).
wiki/graphify-out/

# --- Redundante Archive ---
# Der Notion-Export ist bereits nach raw/ entpackt.
*.zip

# Roh-Exporte aus TradingView: der Inhalt liegt nach tools/sortiere_marktdaten.py
# als Tagesdatei in raw/marktdaten/. Das Original ist ab da redundant -- aufbewahrt,
# aber nicht versioniert (gleiche Logik wie beim Notion-Export-ZIP oben).
raw/_tv-exporte/


# --- Obsidian ---
# Aendert sich bei jedem Fensterwechsel; die uebrige .obsidian/-Config bleibt versioniert.
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# --- Claude Code ---
# Maschinenlokale Permissions/Modes; settings.json (Projekt-Hooks) bleibt versioniert.
.claude/settings.local.json

# --- Zugangsdaten ---
# imgur Client-ID fuer den Screenshot-Upload. Gehoert nie ins Repo, auch nicht ins private.
journal/.secrets.yaml
# FRED-API-Key (stlouisfed.org). Gehoert nie ins Repo, auch nicht ins private.
algo/.secrets.yaml
# IBC-Konfiguration (IB-Gateway-Auto-Login) landet hier NIE direkt -- die eigentliche
# Config liegt unter %USERPROFILE%\ibc\, dieser Eintrag faengt nur einen versehentlichen
# Kopiervorgang ins Repo ab (Design SS9).
algo/ibc/

# --- Python ---
__pycache__/
*.pyc
.venv/

# --- Algo Backtest-Rohlaeufe ---
# Konsolen-Mitschnitt (Progress-Bars) eines Hintergrundlaufs, keine Historie wert --
# Ergebnisse werden nach Abschluss in algo/PLAN.md verdichtet.
algo/walkforward_result.txt
# Debug-Redirects von Testlaeufen im Repo-Root (z.B. "python ... > out.log"), versehentlich
# committet waehrend des 2026-08-06-Praezisions-Audits -- keine Historie wert.
/*.log

# --- OS ---
Thumbs.db
desktop.ini
.DS_Store

# --- Algo Live-Loop ---
# state.json ist reine Laufzeit-Buchhaltung des 10-Minuten-Zyklus (welche Events schon
# gemeldet wurden) und wird bei jedem Lauf neu geschrieben -- keine Historie wert.
algo/live/*/state.json

# Fortschrittslogs langlaufender Prozesse (IBKR-Backfill/-Nachlad, siehe fetch_ibkr.py
# --kein-fenster) -- wachsen waehrend der Prozess laeuft und stehen als offene Datei einem
# Git-Rebase im Weg (Windows verweigert das Ersetzen einer gerade beschriebenen Datei).
# Keine Historie wert, anders als die Text-Statusberichte unten.
algo/live/*.log
algo/live/.fetch_ibkr-fenster.pid

# Die Intraday-CSVs daneben bleiben ab 04.08.2026 bewusst VERSIONIERT: yfinance liefert
# 1m-Daten nur ~30 und 5m nur ~60 Tage rueckwirkend, danach sind diese Snapshots nicht
# mehr rekonstruierbar. ~80 KB je Handelstag sind der Preis dafuer, dass die Datenlage
# spaeter noch vollstaendig ist. Die Text-Statusberichte (algo/live/<datum>-status-log.md)
# waren schon vorher versioniert.

# --- YouTube-Playlist-Ingest ---
# Laufzeit-Checkpoint fuer resumable Playlist-Fetches (fetch_yt_playlist.py) --
# reine Betriebsbuchhaltung, kein Content.
**/.yt_playlist_state/

# Bewusst NICHT ignoriert: raw/ (inkl. aller PNGs), wiki/, site/, CLAUDE.md,
# .claude/settings.json -- das Vault soll vollstaendig gesichert sein.

# --- Algo Forex-Cache ---
# Parquet-Verdichtung von raw/marktdaten-tief/ (73.100 CSVs -> 10 Dateien), jederzeit aus
# raw/ neu baubar (algo/build_parquet.py) -- anders als raw/ selbst gehoert das nicht in
# die Historie (gleiche Begruendung wie graphify-out/ oben).
algo/cache/

# --- Macro-Blockrohzeilen (Forex) ---
# algo/forex/backtest_macro.py schreibt eine Zeile je 20-Minuten-Block: ueber 10 Paare und
# 24 Jahre sind das 3,98 Mio. Zeilen bzw. ~460 MB. Reines Zwischenergebnis, jederzeit aus
# raw/ neu baubar -- gehoert aus demselben Grund nicht in die Historie wie algo/cache/.
#
# Steht hier, weil push.ps1 mit `git add -A` arbeitet und die Datei am 2026-08-15 genau so
# in Commit c73c3122f gelandet ist. Ein einmal gepushter 460-MB-Blob bleibt in der Historie,
# bis sie umgeschrieben wird -- deshalb muss jedes neue Grossartefakt hier eingetragen sein,
# BEVOR der naechste Cron-Lauf es einsammelt.
algo/results/forex_macro_blocks.csv
