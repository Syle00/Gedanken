{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/Jannes/.local/bin/graphify.EXE hook-guard search"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/Jannes/.local/bin/graphify.EXE hook-guard read"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git status --porcelain -- wiki raw | grep -q . && powershell.exe -NoProfile -ExecutionPolicy Bypass -File push.ps1; true",
            "timeout": 120,
            "statusMessage": "Auto-push: neue wiki/raw-Aenderungen erkannt..."
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "ponytail@ponytail": true,
    "superpowers@claude-plugins-official": true
  }
}
